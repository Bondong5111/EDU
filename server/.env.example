# 복사해서 server/.env 로 저장하고 값을 채우세요:  cp server/.env.example server/.env
# 실행: npm start   (Node.js 22.13 이상)

# (필수) 로그인 비밀번호 — 8자 이상, 길고 추측하기 어렵게
APP_PASSWORD=

# 휴대폰·PC에서 접속할 주소 (구글 연결 리디렉트에 사용). 예: https://life.mydomain.com
BASE_URL=http://localhost:8787
PORT=8787
# Cloudflare Tunnel 등 같은 컴퓨터의 터널 뒤에서 돌릴 땐 127.0.0.1 유지
HOST=127.0.0.1
# 터널/리버스 프록시 뒤라면 1 (로그인 시도 제한에 실제 IP 사용)
TRUST_PROXY=0

# (선택) 토스증권 Open API — WTS > 설정 > Open API. 이 서버의 공인 IP를 허용 IP로 등록해야 함
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# (선택) 구글 캘린더 — Google Cloud 콘솔 OAuth 클라이언트(웹 애플리케이션)
# 승인된 리디렉션 URI: {BASE_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (선택) 팻시크릿 식단·체중 — platform.fatsecret.com 개발자 등록 후 받는 OAuth 1.0 키 (Consumer Key / Shared Secret)
# 연결 후 돌아오는 주소: {BASE_URL}/api/fatsecret/callback
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# (선택) 노션 — 기록을 노션 표 5개로 자동 정리 (사이트 → 노션 한 방향)
# 노션 개발자 포털에서 만든 내부 연결(internal connection)의 토큰, 그리고 그 연결에 공유한 페이지 주소
NOTION_TOKEN=
NOTION_PAGE=
# 일정 시각을 노션에 적을 때 쓰는 시간대 (비우면 이 컴퓨터의 시간대)
TIME_ZONE=
